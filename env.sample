APP_NAME=Twisted Services
API_HOST=0.0.0.0
API_PORT=8000
AUTH_BEARER_TOKEN=replace-me
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=replace-me
MASTER_LOGGING_CHANNEL_ID=

# LOGGING_CHANNEL_ID: optional channel for periodic heartbeat messages
LOGGING_CHANNEL_ID=

LOGGING_CC_USER_ID=

# Slack OAuth v2 (posting as the signed-in user)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=https://your-host.example/oauth/callback
PUBLIC_BASE_URL=https://your-host.example
OAUTH_STATE_SECRET=generate-a-long-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_SESSION_HOURS=720
OAUTH_COOKIE_SECURE=true

# Cloudflare R2 uploads for files attached to @Twisted in #twisters
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://twisted.hackclub-assets.com

# PostgreSQL, for example:
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/twisted_services
# Defaults to local SQLite when omitted.
DATABASE_URL=sqlite+aiosqlite:///./twisted_services.db

# Optional run.sh-managed PostgreSQL container. Leave CREATE_DB_CONTAINER=false
# when PostgreSQL is already managed by a hosted service or another stack.
CREATE_DB_CONTAINER=false
DB_CONTAINER_NAME=twisted-services-db
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=twisted_services
POSTGRES_USER=twisted_services
POSTGRES_PASSWORD=
POSTGRES_PORT=5432